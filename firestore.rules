rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Réponses des participants : tout le monde peut lire (c'est le but),
    // mais on ne peut que CRÉER une nouvelle réponse — jamais modifier
    // ou supprimer celle de quelqu'un d'autre après coup.
    match /participants/{docId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['name','characterId','month'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() < 100;
      allow update, delete: if false;
    }

    // Mots doux : même logique — lecture libre, création seule, pas de modif/suppression.
    match /messages/{docId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['name','month'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() < 100;
      allow update, delete: if false;
    }

    // Config du mois (créa, lettre, noms des personnages) : lecture libre,
    // mais l'écriture exige le mot de passe admin envoyé par l'app
    // (le même que celui du mode admin dans js/app.js).
    match /config/{docId} {
      allow read: if true;
      allow write: if request.resource.data.adminKey == "commando2026";
    }

    // Tout le reste (collections non prévues) : bloqué par défaut.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
